# Copy to .env.local for `vercel dev`, and set the same names in the Vercel
# dashboard for preview and production. Never commit real values.

# Scoring. Read only by api/score.js.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 in code.
SCORING_MODEL=

# Voice. Read only by api/voice/speak.js and api/voice/transcribe.js.
# This replaced the old public/config.js, which shipped the key to the browser.
ELEVENLABS_API_KEY=
